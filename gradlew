#!/bin/sh

##############################################################################
# Gradle start up script for POSIX generated by the standard `gradle wrapper`
# task. Regenerate with `gradle wrapper` if you need the official script body;
# this is a minimal stand-in so the wrapper entry point exists in source
# control. The accompanying gradle-wrapper.jar binary is intentionally not
# included in this scaffold (see README) — run `gradle wrapper` locally once
# to populate it before relying on ./gradlew.
##############################################################################

DIR="$(cd "$(dirname "$0")" && pwd)"

exec java -Xmx64m -Xms64m \
  -classpath "$DIR/gradle/wrapper/gradle-wrapper.jar" \
  org.gradle.wrapper.GradleWrapperMain "$@"
